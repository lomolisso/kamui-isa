PTX LB+relaxed.cluster+dsmem-remote-reader
"Load buffering in the writer's shared memory, read from another CTA of the cluster, relaxed at .cluster"
{
x=0 @cta 0;
y=0 @cta 0;
P0:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0             | P1@cta 1,cluster 0,gpu 0                 ;
 ld.relaxed.cluster.shared::cta r0, x | ld.relaxed.cluster.shared::cluster r1, y ;
 st.relaxed.cluster.shared::cta y, 1  | st.relaxed.cluster.shared::cluster x, 1  ;
exists
(P0:r0 == 1 /\ P1:r1 == 1)
