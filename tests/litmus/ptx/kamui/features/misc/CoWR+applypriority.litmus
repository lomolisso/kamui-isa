PTX CoWR+applypriority
"applypriority.global.L2::evict_normal between a store and a read of the same location"
{
x=0;
P0:r0=0;
}
 P0@cta 0,cluster 0,gpu 0                ;
 st.weak.global x, 1                     ;
 applypriority.global.L2::evict_normal x ;
 ld.weak.global r0, x                    ;
exists
(P0:r0 == 0)
