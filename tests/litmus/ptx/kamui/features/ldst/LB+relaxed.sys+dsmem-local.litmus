PTX LB+relaxed.sys+dsmem-local
"Load buffering in the own CTA's shared memory through the cluster window, relaxed at .sys"
{
x=0 @cta 0;
y=0 @cta 0;
P0:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0             | P1@cta 0,cluster 0,gpu 0             ;
 ld.relaxed.sys.shared::cluster r0, x | ld.relaxed.sys.shared::cluster r1, y ;
 st.relaxed.sys.shared::cluster y, 1  | st.relaxed.sys.shared::cluster x, 1  ;
exists
(P0:r0 == 1 /\ P1:r1 == 1)
