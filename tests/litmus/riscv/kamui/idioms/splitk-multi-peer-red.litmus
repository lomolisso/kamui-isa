RISCV splitk-multi-peer-red
"Naive RVWMO lowering (scopes erased) of tests/litmus/ptx/kamui/idioms/splitk-multi-peer-red.litmus"
{
0:x5=w; 0:x6=l; 1:x5=w; 1:x6=l; 2:x5=l; 2:x6=w;
}
 P0                  | P1                  | P2           ;
 ori x7,x0,1         | ori x7,x0,1         | lw x10,0(x5) ;
 amoadd.w x0,x7,(x5) | amoadd.w x0,x7,(x5) | fence r,rw   ;
 fence.tso           | fence.tso           | lw x11,0(x6) ;
 ori x7,x0,1         | ori x7,x0,1         |              ;
 amoadd.w x0,x7,(x6) | amoadd.w x0,x7,(x6) |              ;
exists (2:x10=2 /\ ~(2:x11=2))
