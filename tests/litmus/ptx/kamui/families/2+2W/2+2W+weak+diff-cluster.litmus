PTX 2+2W+weak+diff-cluster
"2+2W: both first stores end up last in coherence order; diff cluster"
{
x=0;
y=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 1,cluster 1,gpu 0 ;
 st.weak x, 1             | st.weak y, 1             ;
 st.weak y, 2             | st.weak x, 2             ;
exists
(x == 1 /\ y == 1)
