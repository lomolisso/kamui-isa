PTX MP+tensormap+rel+acq.cta+same-cta
"tensormap.replace, the release proxy fence and a released flag at .cta; the reader acquires both and copies through the map"
{
g=5;
d=0 @cta 0;
b=mbarrier(1) @cta 0;
tm=0;
f=0;
P1:r0=0;
P1:r2=0;
}
 P0@cta 0,cluster 0,gpu 0                                     | P1@cta 0,cluster 0,gpu 0                                                                         ;
 tensormap.replace.tile.global_address.global.b1024.b64 tm, 1 | ld.acquire.cta r0, f                                                                             ;
 fence.proxy.tensormap::generic.release.cta                   | fence.proxy.tensormap::generic.acquire.cta tm, 128                                               ;
 st.release.cta f, 1                                          | cp.async.bulk.tensor.1d.shared::cluster.global.tile.mbarrier::complete_tx::bytes d, g, b, tm, r2 ;
exists
(P1:r0 == 1 /\ P1:r2 == 0)
