PTX ISA2+weak+diff-cluster
"ISA2: message passing through a third thread (transitivity of synchronization); diff cluster"
{
x=0;
y=0;
z=0;
P1:r0=0;
P2:r1=0;
P2:r2=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 1,cluster 1,gpu 0 | P2@cta 2,cluster 2,gpu 0 ;
 st.weak x, 1             | ld.weak r0, y            | ld.weak r1, z            ;
 st.weak y, 1             | st.weak z, 1             | ld.weak r2, x            ;
exists
(P1:r0 == 1 /\ P2:r1 == 1 /\ P2:r2 == 0)
