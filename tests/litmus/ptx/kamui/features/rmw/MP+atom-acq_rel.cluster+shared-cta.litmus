PTX MP+atom-acq_rel.cluster+shared-cta
"Message passing in the shared memory of the threads' CTA with atom.acq_rel.cluster on both sides"
{
x=0 @cta 0;
f=0 @cta 0;
P0:r9=0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0                       | P1@cta 0,cluster 0,gpu 0                      ;
 st.weak.shared::cta x, 1                       | atom.acq_rel.cluster.shared::cta.add r0, f, 0 ;
 atom.acq_rel.cluster.shared::cta.exch r9, f, 1 | ld.weak.shared::cta r1, x                     ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
