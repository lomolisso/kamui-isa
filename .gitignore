# Compiler intermediates
*.i
*.ii
*.gpu
*.ptx
*.cubin
*.fatbin

# Local working areas
.worktrees/
build/

# Corpus entry and golden directories named after a feature id (atom.scope.gpu) are not compiler intermediates
!tests/corpus/*/*.gpu/
!tests/goldens/*.gpu/

# PTX that the project commits on purpose
!tests/**/*.ptx
!docs/examples/**/*.ptx

# Python caches
__pycache__/
.pytest_cache/
