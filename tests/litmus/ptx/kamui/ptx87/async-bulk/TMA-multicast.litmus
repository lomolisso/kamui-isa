PTX TMA-multicast
"A multicast bulk copy writes the destination in CTA 0 and CTA 1 and signals each CTA's mbarrier (9.7.9.25.4.1). P1 in CTA 1 waits on its own mbarrier and reads its copy. Expected: forbidden."
{
g=5;
d0=0 @cta 0;
d1=0 @cta 1;
b0=mbarrier(1) @cta 0;
b1=mbarrier(1) @cta 1;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0                                                                             | P1@cta 1,cluster 0,gpu 0                        ;
 mbarrier.arrive.expect_tx.release.cta b0, 1                                                          | mbarrier.arrive.expect_tx.release.cta b1, 1     ;
 cp.async.bulk.shared::cluster.global.mbarrier::complete_tx::bytes.multicast::cluster d0+d1, g, b0+b1 | mbarrier.test_wait.parity.acquire.cta r0, b1, 0 ;
                                                                                                      | ld.weak.shared::cta r1, d1                      ;
exists
(P1:r0 == 1 /\ P1:r1 != 5)
