PTX LU+red.cta+shared-cta
"Two relaxed .cta red.add on one location in the shared memory of the threads' CTA"
{
x=0 @cta 0;
}
 P0@cta 0,cluster 0,gpu 0             | P1@cta 0,cluster 0,gpu 0             ;
 red.relaxed.cta.shared::cta.add x, 1 | red.relaxed.cta.shared::cta.add x, 1 ;
exists
(x == 1)
