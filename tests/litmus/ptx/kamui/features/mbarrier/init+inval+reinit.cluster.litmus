PTX init+inval+reinit.cluster
"init, inval and init again in one thread, then use"
{
b=mbarrier() @cta 0;
P0:r0=0;
}
 P0@cta 0,cluster 0,gpu 0                       | P1@cta 1,cluster 0,gpu 0                          ;
 mbarrier.init.shared::cta b, 1                 | barrier.cluster.arrive.relaxed                    ;
 mbarrier.inval.shared::cta b                   | barrier.cluster.wait                              ;
 mbarrier.init.shared::cta b, 1                 | mbarrier.arrive.release.cluster.shared::cluster b ;
 fence.mbarrier_init.release.cluster            | barrier.cluster.arrive                            ;
 barrier.cluster.arrive.relaxed                 | barrier.cluster.wait                              ;
 barrier.cluster.wait                           |                                                   ;
 barrier.cluster.arrive                         |                                                   ;
 barrier.cluster.wait                           |                                                   ;
 mbarrier.test_wait.parity.acquire.cta r0, b, 0 |                                                   ;
exists
(P0:r0 == 0)
