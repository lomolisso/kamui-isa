PTX CoWR+discard+diff-cluster
"A store, discard of its line, a read: the read may return any value"
{
x=0;
y=0;
P0:r0=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 1,cluster 1,gpu 0 ;
 st.weak.global x, 1      | st.weak.global y, 1      ;
 discard.global.L2 x, 128 |                          ;
 ld.weak.global r0, x     |                          ;
exists
(P0:r0 == 7)
