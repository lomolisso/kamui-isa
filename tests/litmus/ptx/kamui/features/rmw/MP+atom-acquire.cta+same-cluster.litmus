PTX MP+atom-acquire.cta+same-cluster
"Message passing with atom.acquire at .cta"
{
x=0;
f=0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 1,cluster 0,gpu 0      ;
 st.weak x, 1             | atom.acquire.cta.add r0, f, 0 ;
 st.release.cta f, 1      | ld.weak r1, x                 ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
