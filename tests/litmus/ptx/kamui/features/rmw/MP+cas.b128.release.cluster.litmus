PTX MP+cas.b128.release.cluster
"Message passing where a 128-bit cas.release.cluster sets the flag"
{
x=0;
f=0;
P0:r9=0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0                  | P1@cta 1,cluster 0,gpu 0 ;
 st.weak x, 1                              | ld.acquire.cluster r0, f ;
 atom.release.cluster.cas.b128 r9, f, 0, 1 | ld.weak r1, x            ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
