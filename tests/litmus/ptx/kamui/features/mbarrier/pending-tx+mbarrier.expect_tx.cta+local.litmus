PTX pending-tx+mbarrier.expect_tx.cta+local
"expect_tx without the matching complete_tx keeps the phase open"
{
b=mbarrier(1) @cta 0;
P1:r0=0;
}
 P0@cta 0,cluster 0,gpu 0            | P1@cta 0,cluster 0,gpu 0                       ;
 mbarrier.expect_tx.relaxed.cta b, 1 | mbarrier.arrive.relaxed.cta b                  ;
                                     | mbarrier.test_wait.parity.relaxed.cta r0, b, 0 ;
exists
(P1:r0 == 1)
