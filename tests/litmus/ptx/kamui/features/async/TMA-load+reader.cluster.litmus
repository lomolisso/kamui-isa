PTX TMA-load+reader.cluster
"A bulk copy into CTA 1's shared memory; a thread of that CTA waits on the mbarrier and reads"
{
g=5;
d=0 @cta 1;
b=mbarrier(1) @cta 1;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0                                                  | P1@cta 1,cluster 0,gpu 0                          ;
 cp.async.bulk.shared::cluster.global.mbarrier::complete_tx::bytes d, g, b | mbarrier.arrive.expect_tx.release.cta b, 1        ;
                                                                           | mbarrier.try_wait.parity.acquire.cluster r0, b, 0 ;
                                                                           | ld.weak.shared::cta r1, d                         ;
exists
(P1:r0 == 1 /\ P1:r1 != 5)
