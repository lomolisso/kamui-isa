PTX IRIW+fence-sc.gpu+same-cta
"IRIW: two readers see two independent writes in opposite orders; same cta"
{
x=0;
y=0;
P2:r0=0;
P2:r1=0;
P3:r2=0;
P3:r3=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 0,cluster 0,gpu 0 | P2@cta 0,cluster 0,gpu 0 | P3@cta 0,cluster 0,gpu 0 ;
 st.relaxed.gpu x, 1      | st.relaxed.gpu y, 1      | ld.relaxed.gpu r0, x     | ld.relaxed.gpu r2, y     ;
                          |                          | fence.sc.gpu             | fence.sc.gpu             ;
                          |                          | ld.relaxed.gpu r1, y     | ld.relaxed.gpu r3, x     ;
exists
(P2:r0 == 1 /\ P2:r1 == 0 /\ P3:r2 == 1 /\ P3:r3 == 0)
