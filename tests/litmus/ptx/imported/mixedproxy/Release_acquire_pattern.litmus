PTX Release_acquire_pattern
"Translated from NVlabs/mixedproxy (permit in the original)"
{
x=0;
y=0;
P1:r1=0;
P1:r3=0;
}
 P0@cta 0,gpu 0      | P1@cta 1,gpu 0       ;
 st.weak y, 1        | ld.relaxed.sys r1, x ;
 st.release.sys x, 1 | fence.acq_rel.sys    ;
 st.relaxed.sys x, 2 | ld.weak r3, y        ;
exists
(P1:r1 == 2 /\ P1:r3 == 0)
