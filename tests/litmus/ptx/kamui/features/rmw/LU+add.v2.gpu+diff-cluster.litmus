PTX LU+add.v2.gpu+diff-cluster
"Two .gpu vector atom.add (v2.f32) on the same two elements"
{
x=0;
y=0;
P0:r0=0;
P0:r1=0;
P1:r2=0;
P1:r3=0;
}
 P0@cta 0,cluster 0,gpu 0                              | P1@cta 1,cluster 1,gpu 0                              ;
 atom.relaxed.gpu.global.v2.f32.add r0, r1, x, y, 1, 1 | atom.relaxed.gpu.global.v2.f32.add r2, r3, x, y, 1, 1 ;
exists
(P0:r0 == 0 /\ P1:r2 == 0)
