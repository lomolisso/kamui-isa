PTX LU+cas.b128.cluster+same-cta
"Two .cluster 128-bit compare-and-swaps: can both succeed?"
{
x=0;
P0:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0                  | P1@cta 0,cluster 0,gpu 0                  ;
 atom.relaxed.cluster.cas.b128 r0, x, 0, 1 | atom.relaxed.cluster.cas.b128 r1, x, 0, 2 ;
exists
(P0:r0 == 0 /\ P1:r1 == 0)
