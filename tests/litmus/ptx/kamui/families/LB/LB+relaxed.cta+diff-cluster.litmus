PTX LB+relaxed.cta+diff-cluster
"Load buffering: each load sees the other thread's later store; diff cluster"
{
x=0;
y=0;
P0:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 1,cluster 1,gpu 0 ;
 ld.relaxed.cta r0, x     | ld.relaxed.cta r1, y     ;
 st.relaxed.cta y, 1      | st.relaxed.cta x, 1      ;
exists
(P0:r0 == 1 /\ P1:r1 == 1)
