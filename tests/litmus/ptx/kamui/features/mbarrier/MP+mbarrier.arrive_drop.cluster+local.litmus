PTX MP+mbarrier.arrive_drop.cluster+local
"Message passing where the producer arrives with arrive_drop"
{
b=mbarrier(1) @cta 0;
x=0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0               | P1@cta 0,cluster 0,gpu 0                           ;
 st.weak x, 1                           | mbarrier.test_wait.parity.acquire.cluster r0, b, 0 ;
 mbarrier.arrive_drop.release.cluster b | ld.weak r1, x                                      ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
