RISCV IRIW_gl_cta
"Naive RVWMO lowering (scopes erased) of tests/litmus/ptx/imported/dat3m/Memalloy/IRIW2.litmus"
{
0:x5=x; 1:x5=x; 1:x6=y; 2:x5=x; 3:x5=x; 3:x6=y;
}
 P0           | P1           | P2           | P3           ;
 ori x10,x0,1 | lw x10,0(x5) | ori x10,x0,1 | lw x10,0(x5) ;
 sw x10,0(x5) | fence rw,rw  | sw x10,0(x5) | fence rw,rw  ;
              | lw x12,0(x6) |              | lw x12,0(x6) ;
exists (1:x10=1 /\ 1:x12=0 /\ 3:x10=1 /\ 3:x12=0)
