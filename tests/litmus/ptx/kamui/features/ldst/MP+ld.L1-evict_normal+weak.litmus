PTX MP+ld.L1-evict_normal+weak
"Message passing with the data loaded with .L1::evict_normal; flag relaxed/relaxed"
{
x=0;
f=0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 1,cluster 0,gpu 0              ;
 st.weak.global x, 1      | ld.relaxed.gpu r0, f                  ;
 st.relaxed.gpu f, 1      | ld.weak.global.L1::evict_normal r1, x ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
