PTX MP+cp.async.cg+acquire
"The copy is issued after an acquire of the producer's flag"
{
d=0 @cta 1;
g=0;
f=0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 1,cluster 0,gpu 0       ;
 st.weak.global g, 1      | ld.acquire.gpu r0, f           ;
 st.release.gpu f, 1      | cp.async.cg.shared.global d, g ;
                          | cp.async.wait_all              ;
                          | ld.weak.shared r1, d           ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
