PTX mbarrier-phase-incomplete
"With an arrival count of 2 and one arrival, phase 0 cannot complete: the wait never returns True. Expected: forbidden."
{
b=mbarrier(2) @cta 0;
P1:r0=0;
}
 P0@cta 0,cluster 0,gpu 0      | P1@cta 0,cluster 0,gpu 0                       ;
 mbarrier.arrive.release.cta b | mbarrier.test_wait.parity.acquire.cta r0, b, 0 ;
exists
(P1:r0 == 1)
