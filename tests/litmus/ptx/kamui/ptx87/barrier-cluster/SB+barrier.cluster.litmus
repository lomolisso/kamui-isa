PTX SB+barrier.cluster
"Store buffering across a cluster barrier: each thread's store precedes the barrier, each load follows it. Expected: forbidden."
{
x=0;
y=0;
P0:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 1,cluster 0,gpu 0 ;
 st.weak x, 1             | st.weak y, 1             ;
 barrier.cluster.arrive   | barrier.cluster.arrive   ;
 barrier.cluster.wait     | barrier.cluster.wait     ;
 ld.weak r0, y            | ld.weak r1, x            ;
exists
(P0:r0 == 0 /\ P1:r1 == 0)
