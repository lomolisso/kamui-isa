PTX IRIW+fence-acq_rel.cluster+same-cluster
"IRIW: two readers see two independent writes in opposite orders; same cluster"
{
x=0;
y=0;
P2:r0=0;
P2:r1=0;
P3:r2=0;
P3:r3=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 1,cluster 0,gpu 0 | P2@cta 2,cluster 0,gpu 0 | P3@cta 3,cluster 0,gpu 0 ;
 st.relaxed.cluster x, 1  | st.relaxed.cluster y, 1  | ld.relaxed.cluster r0, x | ld.relaxed.cluster r2, y ;
                          |                          | fence.acq_rel.cluster    | fence.acq_rel.cluster    ;
                          |                          | ld.relaxed.cluster r1, y | ld.relaxed.cluster r3, x ;
exists
(P2:r0 == 1 /\ P2:r1 == 0 /\ P3:r2 == 1 /\ P3:r3 == 0)
