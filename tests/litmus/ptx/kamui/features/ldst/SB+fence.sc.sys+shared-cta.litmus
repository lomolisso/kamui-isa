PTX SB+fence.sc.sys+shared-cta
"Store buffering in the shared memory of the threads' CTA with fence.sc.sys"
{
x=0 @cta 0;
y=0 @cta 0;
P0:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0         | P1@cta 0,cluster 0,gpu 0         ;
 st.relaxed.sys.shared::cta x, 1  | st.relaxed.sys.shared::cta y, 1  ;
 fence.sc.sys                     | fence.sc.sys                     ;
 ld.relaxed.sys.shared::cta r0, y | ld.relaxed.sys.shared::cta r1, x ;
exists
(P0:r0 == 0 /\ P1:r1 == 0)
