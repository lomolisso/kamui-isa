PTX MP+mbarrier.token.acquire.cluster+remote
"Message passing through an mbarrier of count 2, the consumer waiting by state token (.acquire.cluster)"
{
b=mbarrier(2) @cta 1;
x=0;
P1:r5=0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0                          | P1@cta 1,cluster 0,gpu 0                     ;
 st.weak x, 1                                      | mbarrier.arrive.release.cluster r5, b        ;
 mbarrier.arrive.release.cluster.shared::cluster b | mbarrier.test_wait.acquire.cluster r0, b, r5 ;
                                                   | ld.weak r1, x                                ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
