PTX CoRR+volatile+global+same-cta
"Two volatile reads of one location in global memory, both threads in one CTA"
{
x=0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 0,cluster 0,gpu 0 ;
 st.volatile.global x, 1  | ld.volatile.global r0, x ;
                          | ld.volatile.global r1, x ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
