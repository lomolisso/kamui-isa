PTX LB+relaxed.cluster+global+same-cta
"Load buffering in global memory, both threads in one CTA, relaxed at .cluster"
{
x=0;
y=0;
P0:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0        | P1@cta 0,cluster 0,gpu 0        ;
 ld.relaxed.cluster.global r0, x | ld.relaxed.cluster.global r1, y ;
 st.relaxed.cluster.global y, 1  | st.relaxed.cluster.global x, 1  ;
exists
(P0:r0 == 1 /\ P1:r1 == 1)
