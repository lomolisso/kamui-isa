PTX MP_cta+08
"Translated from NVlabs/mixedproxy (permit in the original)"
{
x=0;
t @ texture aliases x;
s @ surface aliases x;
flag=0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,gpu 0         | P1@cta 0,gpu 0          ;
 sust.weak s, 2         | ld.acquire.cta r0, flag ;
 fence.proxy.texture    | tld.weak r1, t          ;
 fence.proxy.surface    |                         ;
 st.release.cta flag, 1 |                         ;
exists
(P1:r0 == 1 /\ (P1:r1 != 2))
