PTX MP+prefetch-tensormap+relaxed+same-cluster
"Message passing where the reader issues prefetch.tensormap first; flag relaxed/relaxed"
{
tm=1;
x=0;
f=0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 1,cluster 0,gpu 0 ;
 st.weak.global x, 1      | prefetch.tensormap tm    ;
 st.relaxed.gpu f, 1      | ld.relaxed.gpu r0, f     ;
                          | ld.weak.global r1, x     ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
