PTX reduce+no-fence
"cp.reduce.async.bulk adds shared memory into global memory; another thread adds with a generic atomic"
{
s=0 @cta 0;
g=0;
}
 P0@cta 0,cluster 0,gpu 0                                        | P1@cta 1,cluster 0,gpu 0        ;
 st.weak.shared::cta s, 1                                        | red.relaxed.gpu.global.add g, 1 ;
 cp.reduce.async.bulk.global.shared::cta.bulk_group.add.u32 g, s |                                 ;
 cp.async.bulk.commit_group                                      |                                 ;
 cp.async.bulk.wait_group 0                                      |                                 ;
exists
(g == 1)
