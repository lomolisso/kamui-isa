PTX WRC+fence-sc.sys+diff-cluster
"WRC: write-to-read causality, a three-thread chain through two locations; diff cluster"
{
x=0;
y=0;
P1:r0=0;
P2:r1=0;
P2:r2=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 1,cluster 1,gpu 0 | P2@cta 2,cluster 2,gpu 0 ;
 st.relaxed.sys x, 1      | ld.relaxed.sys r0, x     | ld.relaxed.sys r1, y     ;
                          | fence.sc.sys             | fence.sc.sys             ;
                          | st.relaxed.sys y, 1      | ld.relaxed.sys r2, x     ;
exists
(P1:r0 == 1 /\ P2:r1 == 1 /\ P2:r2 == 0)
