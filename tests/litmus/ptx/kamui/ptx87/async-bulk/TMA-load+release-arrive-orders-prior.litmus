PTX TMA-load+release-arrive-orders-prior
"As TMA-load+complete-tx-not-transitive with P0's store before its release arrive: the arrive orders it. Expected: forbidden."
{
g=5;
h=0;
d=0 @cta 0;
b=mbarrier(1) @cta 0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0                                                  | P1@cta 0,cluster 0,gpu 0                       ;
 st.weak.global h, 1                                                       | mbarrier.test_wait.parity.acquire.cta r0, b, 0 ;
 mbarrier.arrive.expect_tx.release.cta b, 1                                | ld.weak.global r1, h                           ;
 cp.async.bulk.shared::cluster.global.mbarrier::complete_tx::bytes d, g, b |                                                ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
