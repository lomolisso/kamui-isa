PTX LU+cas.b128.cluster+shared-cta
"Two .cluster 128-bit compare-and-swaps on a location in the shared memory of the threads' CTA"
{
x=0 @cta 0;
P0:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0                              | P1@cta 0,cluster 0,gpu 0                              ;
 atom.relaxed.cluster.shared::cta.cas.b128 r0, x, 0, 1 | atom.relaxed.cluster.shared::cta.cas.b128 r1, x, 0, 2 ;
exists
(P0:r0 == 0 /\ P1:r1 == 0)
