RISCV IRIW_uniproc
"Naive RVWMO lowering (scopes erased) of tests/litmus/ptx/imported/dat3m/Memalloy/IRIW_uniproc.litmus"
{
0:x5=x; 1:x5=x; 2:x5=x; 3:x5=x;
}
 P0           | P1           | P2           | P3           ;
 ori x10,x0,1 | lw x10,0(x5) | ori x10,x0,2 | lw x10,0(x5) ;
 sw x10,0(x5) | fence rw,rw  | sw x10,0(x5) | fence rw,rw  ;
              | lw x12,0(x5) |              | lw x12,0(x5) ;
exists (1:x10=1 /\ 1:x12=0 /\ 3:x10=2 /\ 3:x12=2 /\ x=1)
