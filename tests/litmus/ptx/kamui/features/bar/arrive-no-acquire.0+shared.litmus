PTX arrive-no-acquire.0+shared
"bar.arrive 0 does not wait: the arriving thread may miss data written before the other thread's bar.sync"
{
x=0 @cta 0;
y=0 @cta 0;
P0:r0=0;
}
 P0@cta 0,cluster 0,gpu 0  | P1@cta 0,cluster 0,gpu 0 ;
 bar.arrive 0, 2           | st.weak.shared::cta y, 1 ;
 ld.weak.shared::cta r0, y | bar.sync 0, 2            ;
exists
(P0:r0 == 0)
