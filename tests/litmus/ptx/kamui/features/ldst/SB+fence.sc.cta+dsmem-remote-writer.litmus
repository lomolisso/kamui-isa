PTX SB+fence.sc.cta+dsmem-remote-writer
"Store buffering in the reader's shared memory, written from another CTA of the cluster with fence.sc.cta"
{
x=0 @cta 1;
y=0 @cta 1;
P0:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0             | P1@cta 1,cluster 0,gpu 0         ;
 st.relaxed.cta.shared::cluster x, 1  | st.relaxed.cta.shared::cta y, 1  ;
 fence.sc.cta                         | fence.sc.cta                     ;
 ld.relaxed.cta.shared::cluster r0, y | ld.relaxed.cta.shared::cta r1, x ;
exists
(P0:r0 == 0 /\ P1:r1 == 0)
