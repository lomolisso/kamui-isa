PTX TMA-load+mbarrier+other-thread
"As TMA-load+mbarrier+same-thread with the wait and the load in another thread of the CTA. Expected: forbidden."
{
g=5;
d=0 @cta 0;
b=mbarrier(1) @cta 0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0                                                  | P1@cta 0,cluster 0,gpu 0                       ;
 mbarrier.arrive.expect_tx.release.cta b, 1                                | mbarrier.test_wait.parity.acquire.cta r0, b, 0 ;
 cp.async.bulk.shared::cluster.global.mbarrier::complete_tx::bytes d, g, b | ld.weak.shared::cta r1, d                      ;
exists
(P1:r0 == 1 /\ P1:r1 != 5)
