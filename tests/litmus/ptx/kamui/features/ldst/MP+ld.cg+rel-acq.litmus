PTX MP+ld.cg+rel-acq
"Message passing with the data loaded with .cg; flag release/acquire"
{
x=0;
f=0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 1,cluster 0,gpu 0 ;
 st.weak.global x, 1      | ld.acquire.gpu r0, f     ;
 st.release.gpu f, 1      | ld.weak.global.cg r1, x  ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
