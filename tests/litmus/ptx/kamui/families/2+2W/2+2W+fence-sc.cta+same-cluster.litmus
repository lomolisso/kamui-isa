PTX 2+2W+fence-sc.cta+same-cluster
"2+2W: both first stores end up last in coherence order; same cluster"
{
x=0;
y=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 1,cluster 0,gpu 0 ;
 st.relaxed.cta x, 1      | st.relaxed.cta y, 1      ;
 fence.sc.cta             | fence.sc.cta             ;
 st.relaxed.cta y, 2      | st.relaxed.cta x, 2      ;
exists
(x == 1 /\ y == 1)
