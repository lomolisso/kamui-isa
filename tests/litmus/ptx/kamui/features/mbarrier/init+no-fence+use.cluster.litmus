PTX init+no-fence+use.cluster
"mbarrier.init in one thread, no-fence, then an arrive from another thread; after a second barrier the owner waits on the phase"
{
b=mbarrier() @cta 0;
P0:r0=0;
}
 P0@cta 0,cluster 0,gpu 0                       | P1@cta 1,cluster 0,gpu 0                          ;
 mbarrier.init.shared::cta b, 1                 | barrier.cluster.arrive.relaxed                    ;
 barrier.cluster.arrive.relaxed                 | barrier.cluster.wait                              ;
 barrier.cluster.wait                           | mbarrier.arrive.release.cluster.shared::cluster b ;
 barrier.cluster.arrive                         | barrier.cluster.arrive                            ;
 barrier.cluster.wait                           | barrier.cluster.wait                              ;
 mbarrier.test_wait.parity.acquire.cta r0, b, 0 |                                                   ;
exists
(P0:r0 == 0)
