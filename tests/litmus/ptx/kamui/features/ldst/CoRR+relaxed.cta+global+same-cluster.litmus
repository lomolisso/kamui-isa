PTX CoRR+relaxed.cta+global+same-cluster
"Two relaxed reads of one location in global memory, the threads in two CTAs of one cluster, at .cta"
{
x=0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0   | P1@cta 1,cluster 0,gpu 0    ;
 st.relaxed.cta.global x, 1 | ld.relaxed.cta.global r0, x ;
                            | ld.relaxed.cta.global r1, x ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
