PTX WRC+fence-sc.gpu+same-cta
"WRC: write-to-read causality, a three-thread chain through two locations; same cta"
{
x=0;
y=0;
P1:r0=0;
P2:r1=0;
P2:r2=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 0,cluster 0,gpu 0 | P2@cta 0,cluster 0,gpu 0 ;
 st.relaxed.gpu x, 1      | ld.relaxed.gpu r0, x     | ld.relaxed.gpu r1, y     ;
                          | fence.sc.gpu             | fence.sc.gpu             ;
                          | st.relaxed.gpu y, 1      | ld.relaxed.gpu r2, x     ;
exists
(P1:r0 == 1 /\ P2:r1 == 1 /\ P2:r2 == 0)
