PTX MP+stmatrix+ldmatrix+barrier.sync
"stmatrix in one thread, ldmatrix in another (barrier.sync)"
{
s=0 @cta 0;
P1:r0=0;
}
 P0@cta 0,cluster 0,gpu 0                      | P1@cta 0,cluster 0,gpu 0                       ;
 stmatrix.sync.aligned.m8n8.x1.shared.b16 s, 1 | barrier.sync 1, 2                              ;
 barrier.sync 1, 2                             | ldmatrix.sync.aligned.m8n8.x1.shared.b16 r0, s ;
exists
(P1:r0 == 0)
