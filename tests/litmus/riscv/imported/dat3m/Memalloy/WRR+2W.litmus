RISCV WRR+2W
"Naive RVWMO lowering (scopes erased) of tests/litmus/ptx/imported/dat3m/Memalloy/WRR+2W.litmus"
{
0:x5=x; 1:x5=x; 1:x6=y; 2:x5=x; 2:x6=y;
}
 P0           | P1           | P2           ;
 ori x10,x0,1 | lw x10,0(x5) | ori x10,x0,2 ;
 sw x10,0(x5) | fence rw,rw  | ori x12,x0,3 ;
              | lw x12,0(x6) | sw x10,0(x5) ;
              |              | fence rw,rw  ;
              |              | sw x12,0(x6) ;
exists (1:x10=1 /\ 1:x12=0 /\ x=1)
