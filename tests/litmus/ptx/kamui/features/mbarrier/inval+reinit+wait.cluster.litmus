PTX inval+reinit+wait.cluster
"A phase completes, the object is invalidated and initialized again; the new phase is the first one"
{
b=mbarrier(1) @cta 0;
P0:r0=0;
P0:r1=0;
}
 P0@cta 0,cluster 0,gpu 0                       ;
 mbarrier.arrive.release.cta b                  ;
 mbarrier.test_wait.parity.acquire.cta r0, b, 0 ;
 mbarrier.inval.shared::cta b                   ;
 mbarrier.init.shared::cta b, 1                 ;
 mbarrier.test_wait.parity.acquire.cta r1, b, 0 ;
exists
(P0:r0 == 1 /\ P0:r1 == 1)
