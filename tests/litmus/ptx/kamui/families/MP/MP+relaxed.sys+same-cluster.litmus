PTX MP+relaxed.sys+same-cluster
"Message passing: thread 1 sees the flag but stale data; same cluster"
{
x=0;
y=0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 1,cluster 0,gpu 0 ;
 st.relaxed.sys x, 1      | ld.relaxed.sys r0, y     ;
 st.relaxed.sys y, 1      | ld.relaxed.sys r1, x     ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
