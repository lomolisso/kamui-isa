PTX MP+vector-release+data
"A store before the vector release store is ordered before both elements. Expected: forbidden."
{
d=0;
x=0;
y=0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,gpu 0               | P1@cta 1,gpu 0       ;
 st.weak d, 1                 | ld.acquire.gpu r0, y ;
 st.release.gpu.v2 x, y, 1, 1 | ld.weak r1, d        ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
