PTX LU+red.async
"Two red.async from two CTAs into a third CTA's location: no lost update"
{
d=0 @cta 2;
b=mbarrier(1) @cta 2;
P2:r0=0;
P2:r1=0;
}
 P0@cta 0,cluster 0,gpu 0                                                               | P1@cta 1,cluster 0,gpu 0                                                               | P2@cta 2,cluster 0,gpu 0                          ;
 red.async.relaxed.cluster.shared::cluster.mbarrier::complete_tx::bytes.add.u32 d, 1, b | red.async.relaxed.cluster.shared::cluster.mbarrier::complete_tx::bytes.add.u32 d, 1, b | mbarrier.arrive.expect_tx.release.cta b, 2        ;
                                                                                        |                                                                                        | mbarrier.try_wait.parity.acquire.cluster r0, b, 0 ;
                                                                                        |                                                                                        | ld.weak.shared::cta r1, d                         ;
exists
(P2:r0 == 1 /\ P2:r1 != 2)
