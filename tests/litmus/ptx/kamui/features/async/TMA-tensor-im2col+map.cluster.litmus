PTX TMA-tensor-im2col+map.cluster
"The tensor copy (im2col) reads the tensor map written before it by the same thread with tensormap.replace and the proxy fences"
{
g=5;
tm=1;
d=0 @cta 1;
b=mbarrier(1) @cta 1;
P0:r2=0;
}
 P0@cta 1,cluster 0,gpu 0                                                                           ;
 tensormap.replace.tile.global_address.global.b1024.b64 tm, 2                                       ;
 fence.proxy.tensormap::generic.release.gpu                                                         ;
 fence.proxy.tensormap::generic.acquire.gpu tm, 128                                                 ;
 cp.async.bulk.tensor.3d.shared::cluster.global.im2col.mbarrier::complete_tx::bytes d, g, b, tm, r2 ;
exists
(P0:r2 == 1)
