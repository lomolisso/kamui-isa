PTX MP2+mbarrier-rel-relaxed.cta+release-side
"As MP2+mbarrier-rel-relaxed.cta, asking about the release side: P0's write is still ordered. Expected: forbidden."
{
b=mbarrier(2) @cta 0;
x=0;
y=0;
P2:r0=0;
P2:r1=0;
P2:r2=0;
}
 P0@cta 0,cluster 0,gpu 0      | P1@cta 0,cluster 0,gpu 0      | P2@cta 0,cluster 0,gpu 0                       ;
 st.weak x, 1                  | st.weak y, 1                  | mbarrier.test_wait.parity.acquire.cta r0, b, 0 ;
 mbarrier.arrive.release.cta b | mbarrier.arrive.relaxed.cta b | ld.weak r1, x                                  ;
                               |                               | ld.weak r2, y                                  ;
exists
(P2:r0 == 1 /\ P2:r1 == 0)
