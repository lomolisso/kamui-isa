PTX MP+atom-release.gpu+same-cta
"Message passing with atom.release at .gpu"
{
x=0;
f=0;
P0:r9=0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0      | P1@cta 0,cluster 0,gpu 0 ;
 st.weak x, 1                  | ld.acquire.gpu r0, f     ;
 atom.release.gpu.add r9, f, 1 | ld.weak r1, x            ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
