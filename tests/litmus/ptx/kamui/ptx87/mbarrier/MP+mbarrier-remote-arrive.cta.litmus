PTX MP+mbarrier-remote-arrive.cta
"As MP+mbarrier-remote-arrive.cluster with the remote arrive at .cta scope (D16). Expected: allowed."
{
b=mbarrier(1) @cta 1;
x=0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0                      | P1@cta 1,cluster 0,gpu 0                           ;
 st.weak x, 1                                  | mbarrier.test_wait.parity.acquire.cluster r0, b, 0 ;
 mbarrier.arrive.release.cta.shared::cluster b | ld.weak r1, x                                      ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
