PTX LB+relaxed.sys+shared-cta
"Load buffering in the shared memory of the threads' CTA, relaxed at .sys"
{
x=0 @cta 0;
y=0 @cta 0;
P0:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0         | P1@cta 0,cluster 0,gpu 0         ;
 ld.relaxed.sys.shared::cta r0, x | ld.relaxed.sys.shared::cta r1, y ;
 st.relaxed.sys.shared::cta y, 1  | st.relaxed.sys.shared::cta x, 1  ;
exists
(P0:r0 == 1 /\ P1:r1 == 1)
