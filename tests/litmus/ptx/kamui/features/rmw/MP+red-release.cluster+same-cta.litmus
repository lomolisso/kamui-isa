PTX MP+red-release.cluster+same-cta
"Message passing, the flag set by red.release.cluster"
{
x=0;
f=0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0     | P1@cta 0,cluster 0,gpu 0 ;
 st.weak x, 1                 | ld.acquire.cluster r0, f ;
 red.release.cluster.add f, 1 | ld.weak r1, x            ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
