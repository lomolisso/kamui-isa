PTX SB+fence.sc.gpu+global+same-cta
"Store buffering in global memory, both threads in one CTA with fence.sc.gpu"
{
x=0;
y=0;
P0:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0    | P1@cta 0,cluster 0,gpu 0    ;
 st.relaxed.gpu.global x, 1  | st.relaxed.gpu.global y, 1  ;
 fence.sc.gpu                | fence.sc.gpu                ;
 ld.relaxed.gpu.global r0, y | ld.relaxed.gpu.global r1, x ;
exists
(P0:r0 == 0 /\ P1:r1 == 0)
