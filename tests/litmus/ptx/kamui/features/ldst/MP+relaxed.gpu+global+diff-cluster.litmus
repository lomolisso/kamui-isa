PTX MP+relaxed.gpu+global+diff-cluster
"Message passing in global memory, the threads in two clusters; flag relaxed/relaxed at .gpu"
{
x=0;
f=0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0   | P1@cta 1,cluster 1,gpu 0    ;
 st.weak.global x, 1        | ld.relaxed.gpu.global r0, f ;
 st.relaxed.gpu.global f, 1 | ld.weak.global r1, x        ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
