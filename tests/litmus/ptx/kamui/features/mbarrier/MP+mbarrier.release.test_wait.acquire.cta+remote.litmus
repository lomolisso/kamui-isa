PTX MP+mbarrier.release.test_wait.acquire.cta+remote
"Message passing through an mbarrier in the consumer's CTA: arrive .release.cta from another CTA, test_wait.parity.acquire.cta"
{
b=mbarrier(1) @cta 1;
x=0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0                      | P1@cta 1,cluster 0,gpu 0                       ;
 st.weak x, 1                                  | mbarrier.test_wait.parity.acquire.cta r0, b, 0 ;
 mbarrier.arrive.release.cta.shared::cluster b | ld.weak r1, x                                  ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
