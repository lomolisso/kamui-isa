PTX MP+add.acquire-reader
"Message passing where the flag is read by atom.acquire.gpu.add"
{
f=0;
x=0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 1,cluster 0,gpu 0      ;
 st.weak x, 1             | atom.acquire.gpu.add r0, f, 1 ;
 st.release.gpu f, 1      | ld.weak r1, x                 ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
