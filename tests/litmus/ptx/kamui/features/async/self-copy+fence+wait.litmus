PTX self-copy+fence+wait
"A bulk copy from shared memory into another location of the same CTA's shared memory"
{
s=0 @cta 0;
d=0 @cta 0;
b=mbarrier(1) @cta 0;
P0:r0=0;
P0:r1=0;
}
 P0@cta 0,cluster 0,gpu 0                                                       ;
 st.weak.shared::cta s, 5                                                       ;
 fence.proxy.async.shared::cta                                                  ;
 mbarrier.arrive.expect_tx.release.cta b, 1                                     ;
 cp.async.bulk.shared::cluster.shared::cta.mbarrier::complete_tx::bytes d, s, b ;
 mbarrier.try_wait.parity.acquire.cta r0, b, 0                                  ;
 ld.weak.shared::cta r1, d                                                      ;
exists
(P0:r0 == 1 /\ P0:r1 != 5)
