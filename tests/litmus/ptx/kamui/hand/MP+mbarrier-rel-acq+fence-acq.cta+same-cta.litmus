PTX MP+mbarrier-rel-acq+fence-acq.cta+same-cta
"As MP+mbarrier-rel-acq, with fence.acq_rel.cta after the test on the acquire side only."
{
x=0;
b=0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0      | P1@cta 0,cluster 0,gpu 0                       ;
 st.weak x, 1                  | mbarrier.test_wait.parity.acquire.cta r0, b, 0 ;
 mbarrier.arrive.release.cta b | fence.acq_rel.cta                              ;
                               | ld.weak r1, x                                  ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
