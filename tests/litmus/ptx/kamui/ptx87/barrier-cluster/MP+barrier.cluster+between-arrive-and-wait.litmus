PTX MP+barrier.cluster+between-arrive-and-wait
"A store between arrive and wait is not ordered (22511). Expected: allowed."
{
x=0;
P1:r0=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 1,cluster 0,gpu 0 ;
 barrier.cluster.arrive   | barrier.cluster.arrive   ;
 st.weak x, 1             | barrier.cluster.wait     ;
 barrier.cluster.wait     | ld.weak r0, x            ;
exists
(P1:r0 == 0)
