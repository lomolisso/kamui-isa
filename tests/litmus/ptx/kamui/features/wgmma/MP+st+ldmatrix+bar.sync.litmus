PTX MP+st+ldmatrix+bar.sync
"A generic store in one thread, ldmatrix in another (bar.sync)"
{
s=0 @cta 0;
P1:r0=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 0,cluster 0,gpu 0                       ;
 st.weak.shared::cta s, 1 | bar.sync 0                                     ;
 bar.sync 0               | ldmatrix.sync.aligned.m8n8.x1.shared.b16 r0, s ;
exists
(P1:r0 == 0)
