PTX LB+relaxed.cta+global+same-cta
"Load buffering in global memory, both threads in one CTA, relaxed at .cta"
{
x=0;
y=0;
P0:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0    | P1@cta 0,cluster 0,gpu 0    ;
 ld.relaxed.cta.global r0, x | ld.relaxed.cta.global r1, y ;
 st.relaxed.cta.global y, 1  | st.relaxed.cta.global x, 1  ;
exists
(P0:r0 == 1 /\ P1:r1 == 1)
