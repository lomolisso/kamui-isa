PTX MP+xor.relaxed-writer
"Message passing where the flag is set by atom.relaxed.gpu.xor"
{
f=0;
x=0;
P0:r9=0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0      | P1@cta 1,cluster 0,gpu 0 ;
 st.weak x, 1                  | ld.acquire.gpu r0, f     ;
 atom.relaxed.gpu.xor r9, f, 1 | ld.weak r1, x            ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
