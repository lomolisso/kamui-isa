PTX MP+barrier.cluster.relaxed+fence.release+shared+same-cta
"Message passing through a cluster barrier, arrive relaxed+fence.release"
{
x=0 @cta 0;
P1:r0=0;
}
 P0@cta 0,cluster 0,gpu 0       | P1@cta 0,cluster 0,gpu 0     ;
 st.weak.shared::cta x, 1       | barrier.cluster.arrive       ;
 fence.release.cluster          | barrier.cluster.wait.acquire ;
 barrier.cluster.arrive.relaxed | ld.weak.shared::cta r0, x    ;
 barrier.cluster.wait           |                              ;
exists
(P1:r0 == 0)
