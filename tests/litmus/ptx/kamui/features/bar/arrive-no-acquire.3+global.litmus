PTX arrive-no-acquire.3+global
"bar.arrive 3 does not wait: the arriving thread may miss data written before the other thread's bar.sync"
{
y=0;
P0:r0=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 0,cluster 0,gpu 0 ;
 bar.arrive 3, 2          | st.weak y, 1             ;
 ld.weak r0, y            | bar.sync 3, 2            ;
exists
(P0:r0 == 0)
