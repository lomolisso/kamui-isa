PTX MP+bar.warp.sync.all+shared
"Message passing through bar.warp.sync with the full warp in the mask"
{
x=0 @cta 0;
y=0 @cta 0;
P1:r0=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 0,cluster 0,gpu 0  ;
 st.weak.shared::cta x, 1 | bar.warp.sync -1          ;
 bar.warp.sync -1         | ld.weak.shared::cta r0, x ;
exists
(P1:r0 == 0)
