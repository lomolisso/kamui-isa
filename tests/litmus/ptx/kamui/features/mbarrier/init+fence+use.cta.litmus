PTX init+fence+use.cta
"mbarrier.init in one thread, fence, then an arrive from another thread; after a second barrier the owner waits on the phase"
{
b=mbarrier() @cta 0;
P0:r0=0;
}
 P0@cta 0,cluster 0,gpu 0                       | P1@cta 0,cluster 0,gpu 0      ;
 mbarrier.init.shared::cta b, 1                 | bar.sync 0                    ;
 fence.mbarrier_init.release.cluster            | mbarrier.arrive.release.cta b ;
 bar.sync 0                                     | bar.sync 0                    ;
 bar.sync 0                                     |                               ;
 mbarrier.test_wait.parity.acquire.cta r0, b, 0 |                               ;
exists
(P0:r0 == 0)
