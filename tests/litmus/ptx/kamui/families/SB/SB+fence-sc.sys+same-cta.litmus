PTX SB+fence-sc.sys+same-cta
"Store buffering: both threads miss the other's store; same cta"
{
x=0;
y=0;
P0:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 0,cluster 0,gpu 0 ;
 st.relaxed.sys x, 1      | st.relaxed.sys y, 1      ;
 fence.sc.sys             | fence.sc.sys             ;
 ld.relaxed.sys r0, y     | ld.relaxed.sys r1, x     ;
exists
(P0:r0 == 0 /\ P1:r1 == 0)
