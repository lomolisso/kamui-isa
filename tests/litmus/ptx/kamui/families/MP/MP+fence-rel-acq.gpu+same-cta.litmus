PTX MP+fence-rel-acq.gpu+same-cta
"Message passing: thread 1 sees the flag but stale data; same cta"
{
x=0;
y=0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 0,cluster 0,gpu 0 ;
 st.weak x, 1             | ld.relaxed.gpu r0, y     ;
 fence.release.gpu        | fence.acquire.gpu        ;
 st.relaxed.gpu y, 1      | ld.weak r1, x            ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
