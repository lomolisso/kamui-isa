PTX SB+membar.gl+same-cluster
"Store buffering with membar.gl (fence.sc.gpu)"
{
x=0;
y=0;
P0:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 1,cluster 0,gpu 0 ;
 st.relaxed.gpu x, 1      | st.relaxed.gpu y, 1      ;
 membar.gl                | membar.gl                ;
 ld.relaxed.gpu r0, y     | ld.relaxed.gpu r1, x     ;
exists
(P0:r0 == 0 /\ P1:r1 == 0)
