PTX LB+relaxed.cluster+same-cta
"Load buffering: each load sees the other thread's later store; same cta"
{
x=0;
y=0;
P0:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 0,cluster 0,gpu 0 ;
 ld.relaxed.cluster r0, x | ld.relaxed.cluster r1, y ;
 st.relaxed.cluster y, 1  | st.relaxed.cluster x, 1  ;
exists
(P0:r0 == 1 /\ P1:r1 == 1)
