PTX param+with-global-traffic
".param loads next to global message passing"
{
c=3;
x=0;
f=0;
P1:r0=0;
P1:r1=0;
P1:r2=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 1,cluster 0,gpu 0 ;
 st.weak.global x, 1      | ld.acquire.gpu r0, f     ;
 st.release.gpu f, 1      | ld.param r1, c           ;
                          | ld.weak r2, x            ;
exists
(P1:r0 == 1 /\ P1:r2 == 0)
