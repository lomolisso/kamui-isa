PTX CoRR+volatile+shared-cta
"Two volatile reads of one location in the shared memory of the threads' CTA"
{
x=0 @cta 0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0     | P1@cta 0,cluster 0,gpu 0      ;
 st.volatile.shared::cta x, 1 | ld.volatile.shared::cta r0, x ;
                              | ld.volatile.shared::cta r1, x ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
