RISCV LB+RMW-b
"Naive RVWMO lowering (scopes erased) of tests/litmus/ptx/imported/dat3m/Manual/LB+RMW-b.litmus"
{
0:x5=y; 0:x6=x; 2:x5=x; 2:x6=y;
}
 P0           | P1 | P2           ;
 lw x10,0(x5) |    | lw x12,0(x5) ;
 fence r,rw   |    | fence rw,w   ;
 ori x7,x0,1  |    | ori x7,x0,1  ;
 sw x7,0(x6)  |    | sw x7,0(x6)  ;
exists (0:x10=1 /\ 2:x12=1)
