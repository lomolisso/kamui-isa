PTX tma-pipeline-war+wgmma+wait_group-1+newer-stage
"As tma-pipeline-war+wgmma+wait_group-1, but the producer refills stage 1, whose wgmma batch wait_group 1 may leave in flight: the wgmma may see the refill. Expected: allowed."
{
g=7;
d0=5 @cta 0;
d1=5 @cta 0;
c=0 @cta 0;
e=mbarrier(1) @cta 0;
f=mbarrier(1) @cta 0;
P0:r0=0;
P1:r1=0;
P1:r2=0;
}
 P0@cta 0,cluster 0,gpu 0                                                   | P1@cta 0,cluster 0,gpu 0               ;
 mbarrier.try_wait.parity.acquire.cta r0, e, 0                              | wgmma.fence.sync.aligned               ;
 mbarrier.arrive.expect_tx.release.cta f, 1                                 | wgmma.mma_async.sync.aligned r1, d0, c ;
 cp.async.bulk.shared::cluster.global.mbarrier::complete_tx::bytes d1, g, f | wgmma.commit_group.sync.aligned        ;
                                                                            | wgmma.mma_async.sync.aligned r2, d1, c ;
                                                                            | wgmma.commit_group.sync.aligned        ;
                                                                            | wgmma.wait_group.sync.aligned 1        ;
                                                                            | mbarrier.arrive.release.cta e          ;
exists
(P0:r0 == 1 /\ P1:r2 == 7)
