PTX LB+relaxed.cluster+dsmem-remote-writer
"Load buffering in the reader's shared memory, written from another CTA of the cluster, relaxed at .cluster"
{
x=0 @cta 1;
y=0 @cta 1;
P0:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0                 | P1@cta 1,cluster 0,gpu 0             ;
 ld.relaxed.cluster.shared::cluster r0, x | ld.relaxed.cluster.shared::cta r1, y ;
 st.relaxed.cluster.shared::cluster y, 1  | st.relaxed.cluster.shared::cta x, 1  ;
exists
(P0:r0 == 1 /\ P1:r1 == 1)
