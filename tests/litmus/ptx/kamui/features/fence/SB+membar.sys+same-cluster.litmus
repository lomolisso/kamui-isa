PTX SB+membar.sys+same-cluster
"Store buffering with membar.sys (fence.sc.sys)"
{
x=0;
y=0;
P0:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 1,cluster 0,gpu 0 ;
 st.relaxed.sys x, 1      | st.relaxed.sys y, 1      ;
 membar.sys               | membar.sys               ;
 ld.relaxed.sys r0, y     | ld.relaxed.sys r1, x     ;
exists
(P0:r0 == 0 /\ P1:r1 == 0)
