PTX MP+cp.async.mbarrier.arrive
"cp.async.mbarrier.arrive.noinc triggers an arrive-on when the thread's earlier cp.async operations complete; a thread whose acquire wait returns True sees the copied data (9.7.13.15.16). Expected: forbidden."
{
g=1;
d=0 @cta 0;
b=mbarrier(1) @cta 0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0                | P1@cta 0,cluster 0,gpu 0                       ;
 cp.async.ca.shared.global d, g          | mbarrier.test_wait.parity.acquire.cta r0, b, 0 ;
 cp.async.mbarrier.arrive.noinc.shared b | ld.weak.shared r1, d                           ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
