PTX MP+rel-acq.cta+generic-shared
"Message passing through the CTA's shared memory with generic addresses; flag release/acquire at .cta"
{
x=0 @cta 0;
f=0 @cta 0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 0,cluster 0,gpu 0 ;
 st.weak x, 1             | ld.acquire.cta r0, f     ;
 st.release.cta f, 1      | ld.weak r1, x            ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
