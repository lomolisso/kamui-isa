PTX MP+atom-acquire.cluster+same-cluster
"Message passing with atom.acquire at .cluster"
{
x=0;
f=0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 1,cluster 0,gpu 0          ;
 st.weak x, 1             | atom.acquire.cluster.add r0, f, 0 ;
 st.release.cluster f, 1  | ld.weak r1, x                     ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
