PTX TMA-load+no-wait.cluster
"The reader reads without waiting on the mbarrier"
{
g=5;
d=0 @cta 1;
b=mbarrier(1) @cta 1;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0                                                  | P1@cta 1,cluster 0,gpu 0  ;
 cp.async.bulk.shared::cluster.global.mbarrier::complete_tx::bytes d, g, b | ld.weak.shared::cta r1, d ;
exists
(P1:r1 != 5)
