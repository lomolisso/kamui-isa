PTX MP+griddep.no-launch.chain
"Three grids, each waiting for the one before"
{
x=0;
P2:r0=0;
}
 P0@cta 0,gpu 0,grid 0 | P1@cta 0,gpu 0,grid 1 | P2@cta 0,gpu 0,grid 2 ;
 st.weak.global x, 1   | griddepcontrol.wait   | griddepcontrol.wait   ;
                       |                       | ld.weak.global r0, x  ;
exists
(P2:r0 == 0)
