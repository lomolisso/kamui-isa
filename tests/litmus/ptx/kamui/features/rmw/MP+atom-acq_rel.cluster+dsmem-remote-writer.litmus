PTX MP+atom-acq_rel.cluster+dsmem-remote-writer
"Message passing in the reader's shared memory, written from another CTA of the cluster with atom.acq_rel.cluster on both sides"
{
x=0 @cta 1;
f=0 @cta 1;
P0:r9=0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0                           | P1@cta 1,cluster 0,gpu 0                      ;
 st.weak.shared::cluster x, 1                       | atom.acq_rel.cluster.shared::cta.add r0, f, 0 ;
 atom.acq_rel.cluster.shared::cluster.exch r9, f, 1 | ld.weak.shared::cta r1, x                     ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
