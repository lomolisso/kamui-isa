PTX MP+membar.sys+same-cta
"Message passing with membar.sys on both sides"
{
x=0;
f=0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 0,cluster 0,gpu 0 ;
 st.weak x, 1             | ld.relaxed.sys r0, f     ;
 membar.sys               | membar.sys               ;
 st.relaxed.sys f, 1      | ld.weak r1, x            ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
