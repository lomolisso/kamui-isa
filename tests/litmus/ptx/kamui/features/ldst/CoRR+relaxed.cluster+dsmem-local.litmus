PTX CoRR+relaxed.cluster+dsmem-local
"Two relaxed reads of one location in the own CTA's shared memory through the cluster window, at .cluster"
{
x=0 @cta 0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0                | P1@cta 0,cluster 0,gpu 0                 ;
 st.relaxed.cluster.shared::cluster x, 1 | ld.relaxed.cluster.shared::cluster r0, x ;
                                         | ld.relaxed.cluster.shared::cluster r1, x ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
