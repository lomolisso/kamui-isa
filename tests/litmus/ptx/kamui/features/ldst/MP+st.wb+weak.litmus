PTX MP+st.wb+weak
"Message passing with the data stored with .wb; flag relaxed/relaxed"
{
x=0;
f=0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 1,cluster 0,gpu 0 ;
 st.weak.global.wb x, 1   | ld.relaxed.gpu r0, f     ;
 st.relaxed.gpu f, 1      | ld.weak.global r1, x     ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
