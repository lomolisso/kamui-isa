PTX CoWR+ld.global.nc+global+diff-cluster
"A thread stores, then reads back with ld.global.nc (global memory, the threads in two clusters)"
{
x=0;
y=0;
P0:r0=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 1,cluster 1,gpu 0 ;
 st.weak.global x, 1      | st.weak.global y, 1      ;
 ld.global.nc r0, x       |                          ;
exists
(P0:r0 == 0)
