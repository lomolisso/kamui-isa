PTX MP+rel-acq.sys+diff-cluster
"Message passing: thread 1 sees the flag but stale data; diff cluster"
{
x=0;
y=0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 1,cluster 1,gpu 0 ;
 st.weak x, 1             | ld.acquire.sys r0, y     ;
 st.release.sys y, 1      | ld.weak r1, x            ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
