PTX 2+2W+fence-sc.sys+diff-cluster
"2+2W: both first stores end up last in coherence order; diff cluster"
{
x=0;
y=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 1,cluster 1,gpu 0 ;
 st.relaxed.sys x, 1      | st.relaxed.sys y, 1      ;
 fence.sc.sys             | fence.sc.sys             ;
 st.relaxed.sys y, 2      | st.relaxed.sys x, 2      ;
exists
(x == 1 /\ y == 1)
