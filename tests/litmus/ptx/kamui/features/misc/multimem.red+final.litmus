PTX multimem.red+final
"Two multimem.red on the same copies: no lost update"
{
x=0;
y=0;
m=multimem(x, y);
}
 P0@cta 0,gpu 0                               | P1@cta 0,gpu 1                               ;
 multimem.red.relaxed.sys.global.add.u32 m, 1 | multimem.red.relaxed.sys.global.add.u32 m, 1 ;
exists
(x == 1)
