PTX WAR+griddep.launch.no-wait
"Grid 0 reads late; grid 1 (no-wait) writes (launch)"
{
x=0;
P0:r0=0;
}
 P0@cta 0,gpu 0,grid 0            | P1@cta 0,gpu 0,grid 1 ;
 griddepcontrol.launch_dependents | st.weak.global x, 1   ;
 ld.weak.global r0, x             |                       ;
exists
(P0:r0 == 1)
