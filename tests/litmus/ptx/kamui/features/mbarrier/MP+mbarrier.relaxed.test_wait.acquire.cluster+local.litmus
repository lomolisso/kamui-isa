PTX MP+mbarrier.relaxed.test_wait.acquire.cluster+local
"Message passing through an mbarrier in the consumer's CTA: arrive .relaxed.cluster, test_wait.parity.acquire.cluster"
{
b=mbarrier(1) @cta 0;
x=0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0          | P1@cta 0,cluster 0,gpu 0                           ;
 st.weak x, 1                      | mbarrier.test_wait.parity.acquire.cluster r0, b, 0 ;
 mbarrier.arrive.relaxed.cluster b | ld.weak r1, x                                      ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
