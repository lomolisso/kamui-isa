PTX cp_fenceproxy+relaxedflag
"tensormap.cp_fenceproxy copies a map from shared memory and releases it to the tensormap proxy; the reader takes the flag and copies through the map"
{
tms=1 @cta 0;
g=5;
d=0 @cta 1;
b=mbarrier(1) @cta 1;
tm=0;
f=0;
P1:r0=0;
P1:r2=0;
}
 P0@cta 0,cluster 0,gpu 0                                                                            | P1@cta 1,cluster 0,gpu 0                                                                         ;
 tensormap.cp_fenceproxy.global.shared::cta.tensormap::generic.release.gpu.sync.aligned tm, tms, 128 | ld.relaxed.gpu r0, f                                                                             ;
 st.relaxed.gpu f, 1                                                                                 | cp.async.bulk.tensor.1d.shared::cluster.global.tile.mbarrier::complete_tx::bytes d, g, b, tm, r2 ;
exists
(P1:r0 == 1 /\ P1:r2 == 0)
