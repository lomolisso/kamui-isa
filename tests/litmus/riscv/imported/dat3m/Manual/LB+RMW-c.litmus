RISCV LB+RMW-c
"Naive RVWMO lowering (scopes erased) of tests/litmus/ptx/imported/dat3m/Manual/LB+RMW-c.litmus"
{
0:x5=y; 0:x6=x; 1:x5=x; 2:x5=x; 2:x6=y;
}
 P0           | P1                   | P2           ;
 lw x10,0(x5) | ori x7,x0,1          | lw x12,0(x5) ;
 fence r,rw   | amoadd.w x11,x7,(x5) | fence rw,w   ;
 ori x7,x0,1  |                      | ori x7,x0,1  ;
 sw x7,0(x6)  |                      | sw x7,0(x6)  ;
exists (0:x10=1 /\ 1:x11=1 /\ 2:x12=2)
