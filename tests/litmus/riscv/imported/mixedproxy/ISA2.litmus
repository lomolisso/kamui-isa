 ori x7,x0,42 | lw x10,0(x5) | lw x11,0(x5) ;
 sw x7,0(x5)  | fence r,rw   | fence r,rw   ;
 fence rw,w   | fence rw,w   | lw x12,0(x6) ;
 ori x7,x0,1  | ori x7,x0,1  |              ;
 sw x7,0(x6)  | sw x7,0(x6)  |              ;
exists (1:x10=1 /\ 2:x11=1 /\ ~(2:x12=42))
