PTX SB+fence-sc.cluster+diff-cluster
"Store buffering: both threads miss the other's store; diff cluster"
{
x=0;
y=0;
P0:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 1,cluster 1,gpu 0 ;
 st.relaxed.cluster x, 1  | st.relaxed.cluster y, 1  ;
 fence.sc.cluster         | fence.sc.cluster         ;
 ld.relaxed.cluster r0, y | ld.relaxed.cluster r1, x ;
exists
(P0:r0 == 0 /\ P1:r1 == 0)
