PTX MP+mbarrier-rel-acq-try_wait.cta+same-cta
"As MP+mbarrier-rel-acq, with the potentially blocking mbarrier.try_wait instead of test_wait."
{
x=0;
b=0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0      | P1@cta 0,cluster 0,gpu 0                      ;
 st.weak x, 1                  | mbarrier.try_wait.parity.acquire.cta r0, b, 0 ;
 mbarrier.arrive.release.cta b | ld.weak r1, x                                 ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
