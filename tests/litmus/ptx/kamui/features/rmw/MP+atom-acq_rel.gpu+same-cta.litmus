PTX MP+atom-acq_rel.gpu+same-cta
"Message passing with atom.acq_rel at .gpu"
{
x=0;
f=0;
P0:r9=0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0      | P1@cta 0,cluster 0,gpu 0      ;
 st.weak x, 1                  | atom.acq_rel.gpu.add r0, f, 0 ;
 atom.acq_rel.gpu.add r9, f, 1 | ld.weak r1, x                 ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
