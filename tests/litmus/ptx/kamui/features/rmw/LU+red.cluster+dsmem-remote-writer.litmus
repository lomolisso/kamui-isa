PTX LU+red.cluster+dsmem-remote-writer
"Two relaxed .cluster red.add on one location in the reader's shared memory, written from another CTA of the cluster"
{
x=0 @cta 1;
}
 P0@cta 0,cluster 0,gpu 0                     | P1@cta 1,cluster 0,gpu 0                 ;
 red.relaxed.cluster.shared::cluster.add x, 1 | red.relaxed.cluster.shared::cta.add x, 1 ;
exists
(x == 1)
