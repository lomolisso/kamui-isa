PTX MP+barrier.cluster-relaxed+fence+same-cluster
"A relaxed cluster arrive preceded by fence.acq_rel.cluster, the pattern the PTX manual gives for barrier.cluster.arrive.relaxed."
{
x=0;
P1:r0=0;
}
 P0@cta 0,cluster 0,gpu 0       | P1@cta 1,cluster 0,gpu 0 ;
 st.weak x, 1                   | barrier.cluster.arrive   ;
 fence.acq_rel.cluster          | barrier.cluster.wait     ;
 barrier.cluster.arrive.relaxed | ld.weak r0, x            ;
 barrier.cluster.wait           |                          ;
exists
(P1:r0 == 0)
