PTX MP+stmatrix+ldmatrix+release-acquire
"stmatrix, a release; ldmatrix after the acquire"
{
s=0 @cta 0;
f=0 @cta 0;
P1:r1=0;
P1:r0=0;
}
 P0@cta 0,cluster 0,gpu 0                      | P1@cta 0,cluster 0,gpu 0                       ;
 stmatrix.sync.aligned.m8n8.x1.shared.b16 s, 1 | ld.acquire.cta.shared::cta r1, f               ;
 st.release.cta.shared::cta f, 1               | ldmatrix.sync.aligned.m8n8.x1.shared.b16 r0, s ;
exists
(P1:r1 == 1 /\ P1:r0 == 0)
