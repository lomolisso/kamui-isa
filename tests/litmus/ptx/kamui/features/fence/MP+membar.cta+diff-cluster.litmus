PTX MP+membar.cta+diff-cluster
"Message passing with membar.cta on both sides"
{
x=0;
f=0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 1,cluster 1,gpu 0 ;
 st.weak x, 1             | ld.relaxed.cta r0, f     ;
 membar.cta               | membar.cta               ;
 st.relaxed.cta f, 1      | ld.weak r1, x            ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
