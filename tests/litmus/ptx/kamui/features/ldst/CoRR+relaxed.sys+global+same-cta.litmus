PTX CoRR+relaxed.sys+global+same-cta
"Two relaxed reads of one location in global memory, both threads in one CTA, at .sys"
{
x=0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0   | P1@cta 0,cluster 0,gpu 0    ;
 st.relaxed.sys.global x, 1 | ld.relaxed.sys.global r0, x ;
                            | ld.relaxed.sys.global r1, x ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
