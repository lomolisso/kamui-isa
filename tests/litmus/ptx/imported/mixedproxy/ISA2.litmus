PTX ISA2
"Translated from NVlabs/mixedproxy (assert in the original)"
{
x=0;
flag1=0;
flag2=0;
P1:r0=0;
P2:r1=0;
P2:r2=0;
}
 P0@cta 0,gpu 0          | P1@cta 0,gpu 0           | P2@cta 1,gpu 0           ;
 st.weak x, 42           | ld.acquire.cta r0, flag1 | ld.acquire.gpu r1, flag2 ;
 st.release.cta flag1, 1 | st.release.gpu flag2, 1  | ld.weak r2, x            ;
exists
(P1:r0 == 1 /\ P2:r1 == 1 /\ ~(P2:r2 == 42))
