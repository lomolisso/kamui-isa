PTX init+inval+reinit.cta
"init, inval and init again in one thread, then use"
{
b=mbarrier() @cta 0;
P0:r0=0;
}
 P0@cta 0,cluster 0,gpu 0                       | P1@cta 0,cluster 0,gpu 0      ;
 mbarrier.init.shared::cta b, 1                 | bar.sync 0                    ;
 mbarrier.inval.shared::cta b                   | mbarrier.arrive.release.cta b ;
 mbarrier.init.shared::cta b, 1                 | bar.sync 0                    ;
 fence.mbarrier_init.release.cluster            |                               ;
 bar.sync 0                                     |                               ;
 bar.sync 0                                     |                               ;
 mbarrier.test_wait.parity.acquire.cta r0, b, 0 |                               ;
exists
(P0:r0 == 0)
