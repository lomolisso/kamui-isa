RISCV CoRR-weak-acquire-weak
"Naive RVWMO lowering (scopes erased) of tests/litmus/ptx/imported/dat3m/Manual/CoRR-weak-acquire-weak.litmus"
{
0:x5=x; 1:x5=x;
}
 P0          | P1           ;
 fence rw,w  | lw x11,0(x5) ;
 ori x7,x0,1 | lw x12,0(x5) ;
 sw x7,0(x5) | fence r,rw   ;
 ori x7,x0,2 | lw x13,0(x5) ;
 sw x7,0(x5) |              ;
exists (1:x11=2 /\ 1:x13=1)
