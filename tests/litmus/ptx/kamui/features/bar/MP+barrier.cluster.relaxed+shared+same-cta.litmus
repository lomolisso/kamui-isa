PTX MP+barrier.cluster.relaxed+shared+same-cta
"Message passing through a cluster barrier, arrive relaxed"
{
x=0 @cta 0;
P1:r0=0;
}
 P0@cta 0,cluster 0,gpu 0       | P1@cta 0,cluster 0,gpu 0     ;
 st.weak.shared::cta x, 1       | barrier.cluster.arrive       ;
 barrier.cluster.arrive.relaxed | barrier.cluster.wait.acquire ;
 barrier.cluster.wait           | ld.weak.shared::cta r0, x    ;
exists
(P1:r0 == 0)
