PTX MP+ldu+global+same-cta
"Message passing in global memory, both threads in one CTA, the data read with ldu.global"
{
x=0;
f=0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0   | P1@cta 0,cluster 0,gpu 0    ;
 st.weak.global x, 1        | ld.acquire.gpu.global r0, f ;
 st.release.gpu.global f, 1 | ldu.global r1, x            ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
