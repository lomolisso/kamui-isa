PTX inval+after-barrier
"One thread uses the object, a barrier, then another invalidates it"
{
b=mbarrier(1) @cta 0;
P0:r0=0;
}
 P0@cta 0,cluster 0,gpu 0          | P1@cta 0,cluster 0,gpu 0     ;
 mbarrier.arrive.release.cta r0, b | bar.sync 0                   ;
 bar.sync 0                        | mbarrier.inval.shared::cta b ;
exists
(P0:r0 != 0)
