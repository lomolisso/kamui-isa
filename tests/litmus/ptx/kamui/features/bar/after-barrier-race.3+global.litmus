PTX after-barrier-race.3+global
"A store after barrier.sync 3 races with the other thread's load after it"
{
x=0;
P1:r0=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 0,cluster 0,gpu 0 ;
 barrier.sync 3           | barrier.sync 3           ;
 st.weak x, 1             | ld.weak r0, x            ;
exists
