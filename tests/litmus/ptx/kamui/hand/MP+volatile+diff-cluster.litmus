PTX MP+volatile+diff-cluster
"Message passing with .volatile accesses on both sides, threads in different clusters."
{
x=0;
y=0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 1,cluster 1,gpu 0 ;
 st.volatile x, 1         | ld.volatile r0, y        ;
 st.volatile y, 1         | ld.volatile r1, x        ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
