PTX SB+fence.sc.cluster+global+diff-cluster
"Store buffering in global memory, the threads in two clusters with fence.sc.cluster"
{
x=0;
y=0;
P0:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0        | P1@cta 1,cluster 1,gpu 0        ;
 st.relaxed.cluster.global x, 1  | st.relaxed.cluster.global y, 1  ;
 fence.sc.cluster                | fence.sc.cluster                ;
 ld.relaxed.cluster.global r0, y | ld.relaxed.cluster.global r1, x ;
exists
(P0:r0 == 0 /\ P1:r1 == 0)
