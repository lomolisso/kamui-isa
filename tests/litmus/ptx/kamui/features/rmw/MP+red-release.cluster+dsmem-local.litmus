PTX MP+red-release.cluster+dsmem-local
"Message passing in the own CTA's shared memory through the cluster window, the flag set by red.release.cluster"
{
x=0 @cta 0;
f=0 @cta 0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0                     | P1@cta 0,cluster 0,gpu 0                 ;
 st.weak.shared::cluster x, 1                 | ld.acquire.cluster.shared::cluster r0, f ;
 red.release.cluster.shared::cluster.add f, 1 | ld.weak.shared::cluster r1, x            ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
