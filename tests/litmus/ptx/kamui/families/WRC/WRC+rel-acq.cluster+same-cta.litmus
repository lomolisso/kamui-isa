PTX WRC+rel-acq.cluster+same-cta
"WRC: write-to-read causality, a three-thread chain through two locations; same cta"
{
x=0;
y=0;
P1:r0=0;
P2:r1=0;
P2:r2=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 0,cluster 0,gpu 0 | P2@cta 0,cluster 0,gpu 0 ;
 st.relaxed.cluster x, 1  | ld.relaxed.cluster r0, x | ld.acquire.cluster r1, y ;
                          | st.release.cluster y, 1  | ld.relaxed.cluster r2, x ;
exists
(P1:r0 == 1 /\ P2:r1 == 1 /\ P2:r2 == 0)
