PTX SB+fence-acq_rel.gpu+same-cluster
"Store buffering: both threads miss the other's store; same cluster"
{
x=0;
y=0;
P0:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 1,cluster 0,gpu 0 ;
 st.relaxed.gpu x, 1      | st.relaxed.gpu y, 1      ;
 fence.acq_rel.gpu        | fence.acq_rel.gpu        ;
 ld.relaxed.gpu r0, y     | ld.relaxed.gpu r1, x     ;
exists
(P0:r0 == 0 /\ P1:r1 == 0)
