PTX TMA-load+same-thread.cta
"A bulk copy into the own CTA's shared memory, waited for on its mbarrier by the issuing thread"
{
g=5;
d=0 @cta 0;
b=mbarrier(1) @cta 0;
P0:r0=0;
P0:r1=0;
}
 P0@cta 0,cluster 0,gpu 0                                                  ;
 mbarrier.arrive.expect_tx.release.cta b, 1                                ;
 cp.async.bulk.shared::cluster.global.mbarrier::complete_tx::bytes d, g, b ;
 mbarrier.try_wait.parity.acquire.cta r0, b, 0                             ;
 ld.weak.shared::cta r1, d                                                 ;
exists
(P0:r0 == 1 /\ P0:r1 != 5)
