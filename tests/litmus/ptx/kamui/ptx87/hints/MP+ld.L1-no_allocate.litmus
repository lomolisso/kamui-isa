PTX MP+ld.L1-no_allocate
"An L1 eviction priority is a hint (15696): the hint does not change the verdict of MP+rel-acq across CTAs. Expected: forbidden."
{
x=0;
f=0;
P1:r0=0;
P1:r1=0;
P1:r2=0;
}
 P0@cta 0,gpu 0      | P1@cta 1,gpu 0                       ;
 st.weak.global x, 1 | ld.weak.global.L1::no_allocate r2, x ;
 st.release.gpu f, 1 | ld.acquire.gpu r0, f                 ;
                     | ld.weak.global.L1::no_allocate r1, x ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
