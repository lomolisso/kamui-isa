PTX MP+membar.gl+same-cta
"Message passing with membar.gl on both sides"
{
x=0;
f=0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 0,cluster 0,gpu 0 ;
 st.weak x, 1             | ld.relaxed.gpu r0, f     ;
 membar.gl                | membar.gl                ;
 st.relaxed.gpu f, 1      | ld.weak r1, x            ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
