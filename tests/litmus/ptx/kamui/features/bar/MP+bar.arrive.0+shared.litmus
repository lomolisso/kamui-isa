PTX MP+bar.arrive.0+shared
"A producer arrives on barrier 0 (bar.arrive), the consumer waits on it (bar.sync)"
{
x=0 @cta 0;
y=0 @cta 0;
P1:r0=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 0,cluster 0,gpu 0  ;
 st.weak.shared::cta x, 1 | bar.sync 0, 2             ;
 bar.arrive 0, 2          | ld.weak.shared::cta r0, x ;
exists
(P1:r0 == 0)
