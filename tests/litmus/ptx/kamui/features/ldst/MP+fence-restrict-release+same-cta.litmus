PTX MP+fence-restrict-release+same-cta
"Message passing in one CTA with a restricted release fence and an acquire load"
{
s=0 @cta 0;
f=0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0                         | P1@cta 0,cluster 0,gpu 0  ;
 st.weak.shared::cta s, 1                         | ld.acquire.cluster r0, f  ;
 fence.release.sync_restrict::shared::cta.cluster | ld.weak.shared::cta r1, s ;
 st.relaxed.cluster f, 1                          |                           ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
