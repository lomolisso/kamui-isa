PTX MP+bar.warp.sync.3+global
"Message passing through bar.warp.sync with both threads in the mask"
{
x=0;
P1:r0=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 0,cluster 0,gpu 0 ;
 st.weak x, 1             | bar.warp.sync 3          ;
 bar.warp.sync 3          | ld.weak r0, x            ;
exists
(P1:r0 == 0)
