PTX SB+fence.sc.cluster+shared-cta
"Store buffering in the shared memory of the threads' CTA with fence.sc.cluster"
{
x=0 @cta 0;
y=0 @cta 0;
P0:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0             | P1@cta 0,cluster 0,gpu 0             ;
 st.relaxed.cluster.shared::cta x, 1  | st.relaxed.cluster.shared::cta y, 1  ;
 fence.sc.cluster                     | fence.sc.cluster                     ;
 ld.relaxed.cluster.shared::cta r0, y | ld.relaxed.cluster.shared::cta r1, x ;
exists
(P0:r0 == 0 /\ P1:r1 == 0)
