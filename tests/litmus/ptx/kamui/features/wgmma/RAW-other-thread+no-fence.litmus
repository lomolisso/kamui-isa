PTX RAW-other-thread+no-fence
"Another thread writes the operand, releases a flag; the wgmma thread acquires it, fences and multiplies"
{
a=0 @cta 0;
c=0 @cta 0;
f=0 @cta 0;
P1:r1=0;
P1:r0=0;
}
 P0@cta 0,cluster 0,gpu 0        | P1@cta 0,cluster 0,gpu 0              ;
 st.weak.shared::cta a, 1        | ld.acquire.cta.shared::cta r1, f      ;
 st.release.cta.shared::cta f, 1 | wgmma.fence.sync.aligned              ;
                                 | wgmma.mma_async.sync.aligned r0, a, c ;
                                 | wgmma.commit_group.sync.aligned       ;
                                 | wgmma.wait_group.sync.aligned 0       ;
exists
(P1:r1 == 1 /\ P1:r0 == 0)
