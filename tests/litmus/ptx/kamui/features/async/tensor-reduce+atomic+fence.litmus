PTX tensor-reduce+atomic+fence
"A tensor reduction and a generic red.add on the same global location: no lost update"
{
s=0 @cta 0;
tm=1;
g=0;
P0:r2=0;
}
 P0@cta 0,cluster 0,gpu 0                                                           | P1@cta 1,cluster 0,gpu 0        ;
 st.weak.shared::cta s, 1                                                           | red.relaxed.gpu.global.add g, 1 ;
 fence.proxy.async.shared::cta                                                      |                                 ;
 cp.reduce.async.bulk.tensor.1d.global.shared::cta.add.tile.bulk_group g, s, tm, r2 |                                 ;
 cp.async.bulk.commit_group                                                         |                                 ;
 cp.async.bulk.wait_group 0                                                         |                                 ;
exists
(g == 1)
