PTX WRC+fence-acq_rel.gpu+same-cluster
"WRC: write-to-read causality, a three-thread chain through two locations; same cluster"
{
x=0;
y=0;
P1:r0=0;
P2:r1=0;
P2:r2=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 1,cluster 0,gpu 0 | P2@cta 2,cluster 0,gpu 0 ;
 st.relaxed.gpu x, 1      | ld.relaxed.gpu r0, x     | ld.relaxed.gpu r1, y     ;
                          | fence.acq_rel.gpu        | fence.acq_rel.gpu        ;
                          | st.relaxed.gpu y, 1      | ld.relaxed.gpu r2, x     ;
exists
(P1:r0 == 1 /\ P2:r1 == 1 /\ P2:r2 == 0)
