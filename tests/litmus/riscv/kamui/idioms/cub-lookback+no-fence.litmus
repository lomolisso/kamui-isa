RISCV cub-lookback+no-fence
"Naive RVWMO lowering (scopes erased) of tests/litmus/ptx/kamui/idioms/cub-lookback+no-fence.litmus"
{
0:x5=v; 0:x6=t; 1:x5=t; 1:x6=v;
}
 P0          | P1           ;
 ori x7,x0,1 | lw x10,0(x5) ;
 sw x7,0(x5) | lw x11,0(x6) ;
