PTX arrive-beyond-pending
"An arrive with a count larger than the pending count is undefined behaviour: any outcome, even a load that misses the thread's own earlier store"
{
b=mbarrier(1) @cta 0;
x=0;
P0:r1=0;
P0:r0=0;
}
 P0@cta 0,cluster 0,gpu 0             ;
 st.weak x, 1                         ;
 mbarrier.arrive.release.cta r1, b, 2 ;
 ld.weak r0, x                        ;
exists
(P0:r0 == 0)
