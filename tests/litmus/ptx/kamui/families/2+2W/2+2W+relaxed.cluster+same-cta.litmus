PTX 2+2W+relaxed.cluster+same-cta
"2+2W: both first stores end up last in coherence order; same cta"
{
x=0;
y=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 0,cluster 0,gpu 0 ;
 st.relaxed.cluster x, 1  | st.relaxed.cluster y, 1  ;
 st.relaxed.cluster y, 2  | st.relaxed.cluster x, 2  ;
exists
(x == 1 /\ y == 1)
