PTX MP+volatile+shared-cta
"Message passing in the shared memory of the threads' CTA, the flag volatile (no release/acquire)"
{
x=0 @cta 0;
f=0 @cta 0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0     | P1@cta 0,cluster 0,gpu 0      ;
 st.weak.shared::cta x, 1     | ld.volatile.shared::cta r0, f ;
 st.volatile.shared::cta f, 1 | ld.weak.shared::cta r1, x     ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
