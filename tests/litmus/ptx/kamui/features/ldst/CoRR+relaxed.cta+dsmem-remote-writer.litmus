PTX CoRR+relaxed.cta+dsmem-remote-writer
"Two relaxed reads of one location in the reader's shared memory, written from another CTA of the cluster, at .cta"
{
x=0 @cta 1;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0            | P1@cta 1,cluster 0,gpu 0         ;
 st.relaxed.cta.shared::cluster x, 1 | ld.relaxed.cta.shared::cta r0, x ;
                                     | ld.relaxed.cta.shared::cta r1, x ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
