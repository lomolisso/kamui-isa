PTX MP+mbarrier-rel-acq-shared.cta+same-cta
"As MP+mbarrier-rel-acq, with the data in shared memory instead of global memory."
{
x=0;
b=0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0      | P1@cta 0,cluster 0,gpu 0                       ;
 st.weak.shared::cta x, 1      | mbarrier.test_wait.parity.acquire.cta r0, b, 0 ;
 mbarrier.arrive.release.cta b | ld.weak.shared::cta r1, x                      ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
