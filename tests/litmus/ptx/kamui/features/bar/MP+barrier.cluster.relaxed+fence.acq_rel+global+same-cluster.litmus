PTX MP+barrier.cluster.relaxed+fence.acq_rel+global+same-cluster
"Message passing through a cluster barrier, arrive relaxed+fence.acq_rel"
{
x=0;
P1:r0=0;
}
 P0@cta 0,cluster 0,gpu 0       | P1@cta 1,cluster 0,gpu 0     ;
 st.weak x, 1                   | barrier.cluster.arrive       ;
 fence.acq_rel.cluster          | barrier.cluster.wait.acquire ;
 barrier.cluster.arrive.relaxed | ld.weak r0, x                ;
 barrier.cluster.wait           |                              ;
exists
(P1:r0 == 0)
