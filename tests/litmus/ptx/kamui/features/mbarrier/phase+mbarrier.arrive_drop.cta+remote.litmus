PTX phase+mbarrier.arrive_drop.cta+remote
"After arrive_drop the expected count shrinks: the next phase completes with the other thread's arrive alone"
{
b=mbarrier(2) @cta 1;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0                           | P1@cta 1,cluster 0,gpu 0                       ;
 mbarrier.arrive_drop.relaxed.cta.shared::cluster b | mbarrier.test_wait.parity.relaxed.cta r0, b, 0 ;
                                                    | mbarrier.arrive.relaxed.cta b                  ;
                                                    | mbarrier.test_wait.parity.relaxed.cta r1, b, 1 ;
exists
(P1:r0 == 0 /\ P1:r1 == 1)
