PTX LU+red.sys+dsmem-local
"Two relaxed .sys red.add on one location in the own CTA's shared memory through the cluster window"
{
x=0 @cta 0;
}
 P0@cta 0,cluster 0,gpu 0                 | P1@cta 0,cluster 0,gpu 0                 ;
 red.relaxed.sys.shared::cluster.add x, 1 | red.relaxed.sys.shared::cluster.add x, 1 ;
exists
(x == 1)
