PTX MP+atom-acquire.cluster+dsmem-remote-writer
"Message passing in the reader's shared memory, written from another CTA of the cluster, the flag read by atom.acquire.cluster"
{
x=0 @cta 1;
f=0 @cta 1;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0                | P1@cta 1,cluster 0,gpu 0                      ;
 st.weak.shared::cluster x, 1            | atom.acquire.cluster.shared::cta.add r0, f, 0 ;
 st.release.cluster.shared::cluster f, 1 | ld.weak.shared::cta r1, x                     ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
