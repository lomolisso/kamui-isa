PTX MP+prefetch.L2+relaxed+same-cta
"Message passing in one CTA where the reader issues prefetch.global.L2 first; flag relaxed/relaxed"
{
x=0;
f=0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 0,cluster 0,gpu 0 ;
 st.weak.global x, 1      | prefetch.global.L2 x     ;
 st.relaxed.gpu f, 1      | ld.relaxed.gpu r0, f     ;
                          | ld.weak.global r1, x     ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
