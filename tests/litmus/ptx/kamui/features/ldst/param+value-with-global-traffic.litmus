PTX param+value-with-global-traffic
"The .param load keeps its value whatever other threads do"
{
c=3;
x=0;
f=0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 1,cluster 0,gpu 0 ;
 st.weak.global x, 1      | ld.acquire.gpu r0, f     ;
 st.release.gpu f, 1      | ld.param r1, c           ;
exists
(P1:r1 != 3)
