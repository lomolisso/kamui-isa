PTX WAR-other-thread+no-wait
"wgmma reads the operand, then bar.sync, and another thread overwrites it"
{
a=1 @cta 0;
c=0 @cta 0;
P0:r0=0;
}
 P0@cta 0,cluster 0,gpu 0              | P1@cta 0,cluster 0,gpu 0 ;
 wgmma.fence.sync.aligned              | bar.sync 0               ;
 wgmma.mma_async.sync.aligned r0, a, c | st.weak.shared::cta a, 2 ;
 wgmma.commit_group.sync.aligned       |                          ;
 bar.sync 0                            |                          ;
exists
(P0:r0 == 2)
