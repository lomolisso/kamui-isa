PTX MP+atom-acquire.sys+diff-cluster
"Message passing with atom.acquire at .sys"
{
x=0;
f=0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 1,cluster 1,gpu 0      ;
 st.weak x, 1             | atom.acquire.sys.add r0, f, 0 ;
 st.release.sys f, 1      | ld.weak r1, x                 ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
