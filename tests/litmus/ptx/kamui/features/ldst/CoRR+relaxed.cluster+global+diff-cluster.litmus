PTX CoRR+relaxed.cluster+global+diff-cluster
"Two relaxed reads of one location in global memory, the threads in two clusters, at .cluster"
{
x=0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0       | P1@cta 1,cluster 1,gpu 0        ;
 st.relaxed.cluster.global x, 1 | ld.relaxed.cluster.global r0, x ;
                                | ld.relaxed.cluster.global r1, x ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
