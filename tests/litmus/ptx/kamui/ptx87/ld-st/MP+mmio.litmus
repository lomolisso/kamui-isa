PTX MP+mmio
"ld.mmio and st.mmio are strong relaxed operations at system scope (6686): no release/acquire, so message passing is not ordered. Expected: allowed."
{
x=0;
f=0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,gpu 0                  | P1@cta 1,gpu 0                   ;
 st.weak.global x, 1             | ld.mmio.relaxed.sys.global r0, f ;
 st.mmio.relaxed.sys.global f, 1 | ld.weak.global r1, x             ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
