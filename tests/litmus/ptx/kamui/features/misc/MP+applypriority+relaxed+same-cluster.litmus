PTX MP+applypriority+relaxed+same-cluster
"Message passing where the reader issues applypriority.global.L2::evict_normal first; flag relaxed/relaxed"
{
x=0;
f=0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 1,cluster 0,gpu 0                ;
 st.weak.global x, 1      | applypriority.global.L2::evict_normal x ;
 st.relaxed.gpu f, 1      | ld.relaxed.gpu r0, f                    ;
                          | ld.weak.global r1, x                    ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
