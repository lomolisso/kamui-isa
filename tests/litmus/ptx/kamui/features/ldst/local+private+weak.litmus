PTX local+private+weak
"Local memory is private: another thread's store to its own local location of the same name is not seen"
{
l=0;
m=0;
P0:r0=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 0,cluster 0,gpu 0 ;
 st.weak.local l, 1       | st.weak.local m, 2       ;
 ld.weak.local r0, l      |                          ;
exists
(P0:r0 == 1)
