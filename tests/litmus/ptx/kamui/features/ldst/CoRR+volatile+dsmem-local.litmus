PTX CoRR+volatile+dsmem-local
"Two volatile reads of one location in the own CTA's shared memory through the cluster window"
{
x=0 @cta 0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0         | P1@cta 0,cluster 0,gpu 0          ;
 st.volatile.shared::cluster x, 1 | ld.volatile.shared::cluster r0, x ;
                                  | ld.volatile.shared::cluster r1, x ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
