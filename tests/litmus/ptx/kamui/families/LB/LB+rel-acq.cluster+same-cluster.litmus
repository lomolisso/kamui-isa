PTX LB+rel-acq.cluster+same-cluster
"Load buffering: each load sees the other thread's later store; same cluster"
{
x=0;
y=0;
P0:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0 | P1@cta 1,cluster 0,gpu 0 ;
 ld.acquire.cluster r0, x | ld.acquire.cluster r1, y ;
 st.release.cluster y, 1  | st.release.cluster x, 1  ;
exists
(P0:r0 == 1 /\ P1:r1 == 1)
