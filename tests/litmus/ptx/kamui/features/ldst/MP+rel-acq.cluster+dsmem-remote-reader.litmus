PTX MP+rel-acq.cluster+dsmem-remote-reader
"Message passing in the writer's shared memory, read from another CTA of the cluster; flag release/acquire at .cluster"
{
x=0 @cta 0;
f=0 @cta 0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0            | P1@cta 1,cluster 0,gpu 0                 ;
 st.weak.shared::cta x, 1            | ld.acquire.cluster.shared::cluster r0, f ;
 st.release.cluster.shared::cta f, 1 | ld.weak.shared::cluster r1, x            ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
