PTX MP+atom-release.cta+dsmem-remote-reader
"Message passing in the writer's shared memory, read from another CTA of the cluster, the flag set by atom.release.cta"
{
x=0 @cta 0;
f=0 @cta 0;
P0:r9=0;
P1:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0                   | P1@cta 1,cluster 0,gpu 0             ;
 st.weak.shared::cta x, 1                   | ld.acquire.cta.shared::cluster r0, f ;
 atom.release.cta.shared::cta.exch r9, f, 1 | ld.weak.shared::cluster r1, x        ;
exists
(P1:r0 == 1 /\ P1:r1 == 0)
