PTX SB+fence.sc.cluster+dsmem-remote-reader
"Store buffering in the writer's shared memory, read from another CTA of the cluster with fence.sc.cluster"
{
x=0 @cta 0;
y=0 @cta 0;
P0:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0             | P1@cta 1,cluster 0,gpu 0                 ;
 st.relaxed.cluster.shared::cta x, 1  | st.relaxed.cluster.shared::cluster y, 1  ;
 fence.sc.cluster                     | fence.sc.cluster                         ;
 ld.relaxed.cluster.shared::cta r0, y | ld.relaxed.cluster.shared::cluster r1, x ;
exists
(P0:r0 == 0 /\ P1:r1 == 0)
