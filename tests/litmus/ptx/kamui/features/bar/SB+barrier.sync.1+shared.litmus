PTX SB+barrier.sync.1+shared
"Each thread stores, meets at barrier.sync 1, then reads the other's location"
{
x=0 @cta 0;
y=0 @cta 0;
P0:r0=0;
P1:r1=0;
}
 P0@cta 0,cluster 0,gpu 0  | P1@cta 0,cluster 0,gpu 0  ;
 st.weak.shared::cta x, 1  | st.weak.shared::cta y, 1  ;
 barrier.sync 1            | barrier.sync 1            ;
 ld.weak.shared::cta r0, y | ld.weak.shared::cta r1, x ;
exists
(P0:r0 == 0 \/ P1:r1 == 0)
